    "record": {
      "id": "industry-mohrss-survey-2025-guide-health-systems",
      "role_id": "guide_health_systems",
      "category": "industry",
      "title": "人社部全国薪酬调查的抽样方法与汇总口径",
      "summary": "官方说明：调查以全国为总体，采用分层PPS抽样，以地区和行业门类为层，层内样本按与企业从业人员人数成比例的概率抽取；各地区按统一制度方法收集数据，使用统一信息系统录入审核后传输至人社部统一汇总计算。说明全国数字是抽样推算结果，不是全量普查。",
      "applicability": "适用于说明全国工资价位数据的抽样属性与可比性边界。不适用于推断单个企业或单个地区的精确值。",
      "relation": "direct",
      "tags": [
        "抽样方法",
        "PPS",
        "统计口径",
        "人社部",
        "全国"
      ],
      "valid_through": null,
      "freshness_days": 60,
      "context": {
        "statistic_scope": "人社部2025年企业薪酬调查（全国），单位万元/年，5列为10%/25%/50%/75%/90%分位值"
      }
    },
    "extracts": [
      {
        "field": "coverage_limit",
        "pattern": "2\\. 调查方法 调查以全国为总体，采用分层PPS抽样方法，以地区和行业门类为层，层内样本按照与企业从业人员人数成比例的概率抽取。 各地区按照统一的制度方法组织收集调查企业从业人员工资报酬等数据，使用统一的信息系统对数据进行录入、审核，然后传输至人社部进行统一汇总计算。"
      }
    ],
    "expected_fields": [
      "coverage_limit",
      "全量普查数据",
      "企业级数据"
    ]
  },
