      0.5,
      1,
      1.5,
      2
    ],
    "users_per_level": 60,
    "clip": [
      0,
      10
    ]
  },
  "thresholds": {
    "spearman_mean_min": 0.8,
    "spearman_p10_min": 0.4
  },
