# Copy to project root .env.local and fill values yourself. NEVER commit .env.local
ONET_API_KEY=REPLACE_WITH_NEW_ROTATED_KEY
SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
# P0 validation console: explicitly enable only for closed development testing.
LIMEN_ENABLE_P0_CONSOLE=false
# Optional canonical origin when running behind a trusted reverse proxy.
LIMEN_APP_ORIGIN=
# Optional: choose your provider/model; secrets server-side ONLY
# Disabled by default. Enable only for an explicitly authorized service/cost.
LIMEN_ENABLE_LLM=false
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=
LLM_MODEL=
