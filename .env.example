# Copy to project root .env.local and fill values yourself. NEVER commit .env.local
ONET_API_KEY=REPLACE_WITH_NEW_ROTATED_KEY
SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
# P0 validation console: explicitly enable only for closed development testing.
LIMEN_ENABLE_P0_CONSOLE=false
# Optional canonical origin when running behind a trusted reverse proxy.
LIMEN_APP_ORIGIN=
# Optional: choose your provider/model; secrets server-side ONLY
# Disabled by default. Enable only for an explicitly authorized service/cost.
LIMEN_ENABLE_LLM=false
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=
LLM_MODEL=
# Cloud/local digital-human gateway. Server only, never NEXT_PUBLIC_.
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=
# Original application above is retained for legacy medical-session cleanup.
# Dedicated doctor application for medical teaching (falls back only on older deployments).
XINGYUN_MEDICINE_APP_ID=
XINGYUN_MEDICINE_APP_SECRET=
# Biomedical engineering and product-manager experiences use this application.
XINGYUN_ENGINEERING_APP_ID=
XINGYUN_ENGINEERING_APP_SECRET=
# Computing application; informatics uses the original male presenter's application.
XINGYUN_COMPUTING_APP_ID=
XINGYUN_COMPUTING_APP_SECRET=
XINGYUN_INFORMATICS_APP_ID=
XINGYUN_INFORMATICS_APP_SECRET=
